# Application
APP_NAME=Expense Tracker API
ENVIRONMENT=development
LOG_LEVEL=INFO
API_VERSION=0.1.0

# Database
# Use DATABASE_URL for Postgres or other SQLAlchemy-supported DBs, e.g.:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB_NAME
# By default we use a local SQLite file under ./data
SQLITE_URL=sqlite:///./data/expense_tracker.db

# CORS configuration (comma-separated lists)
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# Security
CSRF_ENABLED=false
