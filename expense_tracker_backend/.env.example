# Backend environment configuration for Expense Tracker API

# App
APP_NAME=Expense Tracker API
ENVIRONMENT=development
LOG_LEVEL=INFO
API_VERSION=0.1.0

# Security / Auth
# IMPORTANT: Generate a strong secret in production (e.g., `openssl rand -base64 32`)
SECRET_KEY=change-me-in-prod
ACCESS_TOKEN_EXPIRES_MIN=15
REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_COOKIE_NAME=rt
# Use true in production (served over HTTPS). For local dev on http://localhost use false.
COOKIE_SECURE=false
# "lax" recommended for refresh cookie; "none" requires HTTPS (Secure) in modern browsers
COOKIE_SAMESITE=lax

# Database
# Default uses SQLite file in ./data. For Postgres: postgresql+psycopg2://USER:PASS@HOST:5432/DB
DATABASE_URL=sqlite:///./data/expense_tracker.db

# CORS
# Comma-separated list of allowed origins. Make sure to include the frontend URL(s).
# Example for local dev React app:
CORS_ALLOW_ORIGINS=http://localhost:3000,https://vscode-internal-16978-beta.beta01.cloud.kavia.ai:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type
